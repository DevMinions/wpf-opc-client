<Project>
  <!--
    改动说明（GPL-3.0 §5 标注修改）：
    原文件通过 Nerdbank.GitVersioning 从 git 历史推算版本号。本仓库将该 GPL 源码
    内置（vendored，非 submodule），脱离了其原始 git 仓库，NBGV 无法定位版本 →
    改为静态版本号。上游原始版本见同目录 version.json（4.0.0-rc）。
  -->
  <PropertyGroup>
    <Version>4.0.0</Version>
    <VersionPrefix>4.0.0</VersionPrefix>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
  </PropertyGroup>
</Project>
