{
  "Database": {
    "Path": "sqlite.db"
  },
  "Orchestrator": {
    "WatchdogIntervalSeconds": 30,
    "HeartbeatTimeoutSeconds": 120
  },
  "Diagnostics": {
    "ReportIntervalSeconds": 30,
    "EnableLogging": true,
    "EnableMetrics": true
  },
  "Messaging": {
    "Format": "msgpack",
    "Queue": {
      "Enabled": false,
      "Directory": "queue",
      "MaxBytes": 104857600
    }
  },
  "OpcUa": {
    "AutoAcceptUntrustedCertificates": false,
    "MinimumCertificateKeySize": 2048
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
