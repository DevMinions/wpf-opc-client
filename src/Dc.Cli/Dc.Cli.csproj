<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 纯 net8.0（非 -windows）：可在 Linux/Docker 运行。仅 UA（DA/AE 走 COM，需 Windows 构建）。 -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Dc.Cli</RootNamespace>
    <AssemblyName>Dc.Cli</AssemblyName>
    <Version>1.2.0</Version>
    <Product>Dc — OPC 数据采集（无头）</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dc.Domain\Dc.Domain.csproj" />
    <ProjectReference Include="..\Dc.Infrastructure\Dc.Infrastructure.csproj" />
    <ProjectReference Include="..\Dc.Opc.Abstractions\Dc.Opc.Abstractions.csproj" />
    <ProjectReference Include="..\Dc.Opc.Ua\Dc.Opc.Ua.csproj" />
  </ItemGroup>
</Project>
