<UserControl x:Class="Dc.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <Grid Background="#1B2636">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc Placeholder_NotImplemented}" Foreground="#7E8A99" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
