<Window x:Class="Dc.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Dc.App.Markup"
        Title="{loc:Loc Nav_About}" Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Direction="270" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{loc:Loc Nav_About}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource DcBtnGhostSm}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsCancel="True" />
                </Grid>
            </Border>
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Product}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="16" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc About_CompanyLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Company}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc About_RuntimeLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Runtime}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc About_BuildDateLabel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildDate}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0">
                    <Run Text="{loc:Loc About_Body}" /><LineBreak /><LineBreak /><Run Text="{loc:Loc About_BodyRewrite}" />
                </TextBlock>

                <Button Grid.Row="3" Content="{loc:Loc About_Close}" HorizontalAlignment="Right" Style="{StaticResource DcBtnGhostSm}"
                        IsCancel="True" IsDefault="True" Padding="8,6" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
