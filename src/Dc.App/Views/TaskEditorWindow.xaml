<Window x:Class="Dc.App.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Dc.App.Controls"
        Title="{Binding Title}" Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Direction="270" />
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Padding="6,2"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            IsCancel="True" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Padding="14,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" AutomationProperties.AutomationId="TaskCancel" Width="80" Margin="0,0,8,0" IsCancel="True"
                            Style="{StaticResource DcBtnGhostSm}" />
                    <Button x:Name="SaveButton" AutomationProperties.AutomationId="TaskSave" Content="保存" Width="80"
                            Click="OnSaveClick" IsDefault="True" IsEnabled="{Binding CanSave}"
                            Style="{StaticResource DcBtnPrimarySm}" />
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="协议:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="TaskProtocol"
                                  ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="TaskServer" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                 controls:Placeholder.Text="DA: ProgID / UA: opc.tcp://host:port" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="节点:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="TaskNode" Text="{Binding Node, UpdateSourceTrigger=PropertyChanged}"
                                 controls:Placeholder.Text="主机名或 IP" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="采样间隔:" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                            <TextBox Height="30" AutomationProperties.AutomationId="TaskInterval" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="毫秒 · 必须 &gt; 0" FontSize="11" Margin="2,3,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="死区:" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                            <TextBox Height="30" AutomationProperties.AutomationId="TaskDeviation" Text="{Binding Deviation, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="百分比 0 – 100" FontSize="11" Margin="2,3,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="TCP 地址:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.AutomationId="TaskTcpAddress" Text="{Binding TcpAddress, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- DA scan section -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" Padding="0,10,0,8" Margin="0,10,0,0"
                            Visibility="{Binding IsClassicOpcProtocol, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="按 IP 扫描 OPC 服务器"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="目标 IP:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" Width="108" DockPanel.Dock="Left" />
                                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ScanRun" Content="扫描" Margin="8,0,0,0"
                                        Command="{Binding ScanCommand}"
                                        Style="{StaticResource DcBtnGhostSm}" />
                                <TextBox AutomationProperties.AutomationId="ScanHost" Text="{Binding DiscoveryHost, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" controls:Placeholder.Text="localhost" />
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock Text="发现:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" Width="108" DockPanel.Dock="Left" />
                                <ComboBox AutomationProperties.AutomationId="ScanResult" ItemsSource="{Binding DiscoveredServers}" SelectedItem="{Binding SelectedDiscoveredServer}"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Expander Header="高级（CLSID 直连）" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0" Padding="0,4,0,4" Margin="0,8,0,0"
                              Visibility="{Binding IsClassicOpcProtocol, Converter={StaticResource BoolToVis}}"
                              IsExpanded="False">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <TextBlock Text="CLSID:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Width="108" DockPanel.Dock="Left" />
                            <TextBox AutomationProperties.AutomationId="TaskClsid" VerticalAlignment="Center" FontFamily="Consolas"
                                     Text="{Binding Clsid, UpdateSourceTrigger=PropertyChanged}"
                                     controls:Placeholder.Text="CLSID 格式: 5CEE2576-..." />
                        </DockPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
