<UserControl x:Class="Dc.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Dc.App.Views.Converters">
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </UserControl.Resources>

    <!-- Root: follow app theme -->
    <ScrollViewer Background="{DynamicResource ApplicationBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- Page title -->
            <TextBlock Text="设置" Style="{StaticResource DcPageTitle}" />
            <TextBlock Text="外观、系统配置项、备份与恢复"
                       Style="{StaticResource DcPageSub}" />

            <!-- ══════════════════════════════════════
                 Card 1 — 外观
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource DcCardHeader}" />

                    <!-- 主题 row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Label + description -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="主题"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="跟随系统时随 Windows 亮/暗切换"
                                       Style="{StaticResource DcMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Radio buttons — keep existing bindings via EnumMatchConverter -->
                        <StackPanel Grid.Column="1"
                                    DataContext="{Binding Theme}"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="亮色"
                                         GroupName="apptheme"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=Light}" />
                            <RadioButton Content="暗色"
                                         GroupName="apptheme"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=Dark}" />
                            <RadioButton Content="跟随系统"
                                         GroupName="apptheme"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=System}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════
                 Card 2 — 系统配置项
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Header row: title + 新建 button -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="系统配置项"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="+ 新建"
                                        Command="{Binding NewCommand}"
                                        Style="{StaticResource DcBtnPrimarySm}"
                                        Margin="0,0,6,0" />
                            <Button Content="编辑"
                                        Command="{Binding EditCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,6,0" />
                            <Button Content="删除"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,6,0" />
                            <Button Content="刷新"
                                        Command="{Binding LoadCommand}"
                                        Style="{StaticResource DcBtnGhostSm}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid — transparent, no border -->
                    <DataGrid ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              Style="{StaticResource DcDataGrid}"
                              RowStyle="{StaticResource DcDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}">
                         <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="更新时间"
                                                Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════
                 Card 3 — 备份与恢复
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}">
                <StackPanel>
                    <TextBlock Text="备份与恢复" Style="{StaticResource DcCardHeader}" />

                    <!-- 备份 row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="配置备份"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="导出/导入全部任务·Tag·配置"
                                       Style="{StaticResource DcMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="导出全部"
                                        Command="{Binding ExportBackupCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,8,0" />
                            <Button Content="导入备份…"
                                        Command="{Binding ImportBackupCommand}"
                                        Style="{StaticResource DcBtnGhostSm}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
