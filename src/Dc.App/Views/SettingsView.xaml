<UserControl x:Class="Dc.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Dc.App.Views.Converters"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </UserControl.Resources>

    <!-- Root: follow app theme -->
    <ScrollViewer Background="{DynamicResource ApplicationBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- Page title -->
            <TextBlock Text="{loc:Loc Settings_Title}" Style="{StaticResource DcPageTitle}" />
            <TextBlock Text="{loc:Loc Settings_Subtitle}"
                       Style="{StaticResource DcPageSub}" />

            <!-- ══════════════════════════════════════
                 Card 1 — 外观
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Appearance}" Style="{StaticResource DcCardHeader}" />

                    <!-- 主题 row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Label + description -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Theme}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{loc:Loc Settings_ThemeHint}"
                                       Style="{StaticResource DcMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Radio buttons — keep existing bindings via EnumMatchConverter -->
                        <StackPanel Grid.Column="1"
                                    DataContext="{Binding Theme}"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Theme_Light}"
                                         GroupName="apptheme"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=Light}" />
                            <RadioButton Content="{loc:Loc Theme_Dark}"
                                         GroupName="apptheme"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=Dark}" />
                            <RadioButton Content="{loc:Loc Theme_System}"
                                         GroupName="apptheme"
                                         IsChecked="{Binding SelectedTheme,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=System}" />
                        </StackPanel>
                    </Grid>

                    <!-- 语言 row -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Language}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    DataContext="{Binding Language}"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Lang_ChineseSimplified}"
                                         GroupName="applang"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedLanguage,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=ChineseSimplified}" />
                            <RadioButton Content="{loc:Loc Lang_English}"
                                         GroupName="applang"
                                         Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedLanguage,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=English}" />
                            <RadioButton Content="{loc:Loc Lang_System}"
                                         GroupName="applang"
                                         IsChecked="{Binding SelectedLanguage,
                                             Converter={StaticResource EnumMatch},
                                             ConverterParameter=System}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════
                 Card 2 — 系统配置项
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Header row: title + 新建 button -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Settings_SystemConfig}"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{loc:Loc Workspace_NewTask}"
                                        Command="{Binding NewCommand}"
                                        Style="{StaticResource DcBtnPrimarySm}"
                                        Margin="0,0,6,0" />
                            <Button Content="{loc:Loc Common_Edit}"
                                        Command="{Binding EditCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,6,0" />
                            <Button Content="{loc:Loc Common_Delete}"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,6,0" />
                            <Button Content="{loc:Loc Common_Refresh}"
                                        Command="{Binding LoadCommand}"
                                        Style="{StaticResource DcBtnGhostSm}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid — transparent, no border -->
                    <DataGrid ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              Style="{StaticResource DcDataGrid}"
                              RowStyle="{StaticResource DcDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}">
                         <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Settings_ColDescription}" Binding="{Binding Description}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Settings_ColUpdatedAt}"
                                                Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════
                 Card 3 — 备份与恢复
            ══════════════════════════════════════ -->
            <Border Style="{StaticResource DcCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_BackupRestore}" Style="{StaticResource DcCardHeader}" />

                    <!-- 备份 row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_ConfigBackup}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{loc:Loc Settings_ConfigBackupHint}"
                                       Style="{StaticResource DcMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="{loc:Loc Settings_ExportAll}"
                                        Command="{Binding ExportBackupCommand}"
                                        Style="{StaticResource DcBtnGhostSm}"
                                        Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Settings_ImportBackup}"
                                        Command="{Binding ImportBackupCommand}"
                                        Style="{StaticResource DcBtnGhostSm}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
