<UserControl x:Class="Dc.App.Views.LiveDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Dc.App.Controls">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page header ===== -->
        <StackPanel Grid.Row="0" Margin="20,20,20,4">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DcPageTitle}" />
            <TextBlock Text="跨任务实时值流 · 质量码着色" Style="{StaticResource DcPageSub}" />
        </StackPanel>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="20,0,20,12"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Task filter -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="任务筛选:"
                               Style="{StaticResource DcMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox Width="220"
                              ItemsSource="{Binding AvailableTasks}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding TaskFilter}"
                              VerticalAlignment="Center" />
                    <Button Content="清除"
                                Margin="6,0,0,0"
                                Style="{StaticResource DcBtnGhostSm}"
                                Command="{Binding ClearFilterCommand}"
                                VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search by Item -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="搜索:" Style="{StaticResource DcMuted}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="200" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Right-side actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource DcMuted}">
                        <Run Text="{Binding RowCount, Mode=OneWay}" /><Run Text=" 行 · " /><Run Text="{Binding UpdatesPerSecond, Mode=OneWay, StringFormat=F0}" /><Run Text="/s" />
                    </TextBlock>
                    <ToggleButton IsChecked="{Binding Paused}"
                                  Padding="12,5"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Content" Value="⏸ 暂停" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="▶ 继续" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="清空"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource DcBtnGhostSm}"
                                VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Values card ===== -->
        <Border Grid.Row="2"
                Style="{StaticResource DcCard}"
                Margin="20,0,20,20"
                Padding="0"
                Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
            <DataGrid ItemsSource="{Binding RowsView}"
                      Style="{StaticResource DcDataGrid}"
                       EnableRowVirtualization="True"
                       EnableColumnVirtualization="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.IsDeferredScrollingEnabled="True"
                       RowStyle="{StaticResource DcDataGridRow}"
                        ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}">

                <DataGrid.Columns>

                    <!-- Status dot -->
                    <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Item (monospace) -->
                    <DataGridTemplateColumn Header="Item" Width="240" SortMemberPath="Item">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Item}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Task -->
                    <DataGridTextColumn Header="任务" Binding="{Binding TaskName}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Value -->
                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Quality pill -->
                    <DataGridTemplateColumn Header="质量" Width="100" SortMemberPath="Quality">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 三态质量（Good/Uncertain/Bad），软底 + 同色文字（对齐原型 pill 风格） -->
                                <Border CornerRadius="999"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="8,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- default: Bad 软底 -->
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- default: Bad -->
                                                <Setter Property="Text" Value="Bad" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                                        <Setter Property="Text" Value="Uncertain" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                        <Setter Property="Text" Value="Good" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Timestamp (monospace, muted) -->
                    <DataGridTemplateColumn Header="时间戳" Width="130" SortMemberPath="Timestamp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Update count (muted) -->
                    <DataGridTextColumn Header="更新数" Binding="{Binding UpdateCount}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <controls:EmptyState Grid.Row="2"
            Icon="DataHistogram24"
            Title="暂无实时数据"
            Hint="运行采集任务后，这里实时显示订阅值"
            ActionText="{Binding NavigateCtaText}"
            ActionCommand="{Binding NavigateToWorkspaceCommand}"
            Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}}" />
    </Grid>
</UserControl>
