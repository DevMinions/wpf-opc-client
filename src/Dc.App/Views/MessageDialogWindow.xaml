<views:ModalWindowBase x:Class="Dc.App.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dc.App.Views">
    <!-- 全屏半透明遮罩:盖住 Owner 内容,杜绝背后文字透出叠加到弹窗上。尺寸+居中由 ModalWindowBase 处理。 -->
    <Grid x:Name="Root" Background="#80000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- 卡片用不透明底,不再用半透明 CardBackground,避免透字 -->
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    MinWidth="360" MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="16,14"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IconText" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" />
                                <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" Padding="6,2"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    IsCancel="True" />
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom" Padding="14,14"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel x:Name="FooterPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
                    </Border>

                    <!-- Body -->
                    <TextBlock x:Name="BodyText"
                               Padding="20,16"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ModalWindowBase>
