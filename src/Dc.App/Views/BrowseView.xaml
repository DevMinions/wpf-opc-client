<UserControl x:Class="Dc.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Dc.App.Controls"
             xmlns:lconv="clr-namespace:Dc.App.Views.Converters"
             xmlns:i18n="clr-namespace:Dc.App.Services.I18n"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lconv:LocalizedFormatConverter x:Key="LocFormat" />
        <!-- 代理:让不在可视树的 DataGridColumn 也能绑 VM 的 ShowBulkAdd(对话框单点取用时隐藏多选列) -->
        <controls:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- page header -->
            <RowDefinition Height="Auto" />
            <!-- connection toolbar -->
            <RowDefinition Height="Auto" />
            <!-- classic OPC scan row -->
            <RowDefinition Height="Auto" />
            <!-- classic OPC CLSID expander -->
            <RowDefinition Height="Auto" />
            <!-- breadcrumb -->
            <RowDefinition Height="Auto" />
            <!-- connect error bar -->
            <RowDefinition Height="Auto" />
            <!-- split: node list + detail -->
            <RowDefinition Height="*" />
            <!-- bulk add-as-tag action bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Page header ═══ -->
        <StackPanel Grid.Row="0" Margin="20,16,20,4">
            <TextBlock Text="{loc:Loc Browse_Title}" Style="{StaticResource DcPageTitle}" />
            <TextBlock Text="{loc:Loc Browse_Subtitle}"
                       Style="{StaticResource DcPageSub}" />
        </StackPanel>

        <!-- ═══ Row 1: Connection toolbar ═══ -->
        <Border Grid.Row="1" Margin="20,0,20,10">
            <Border Style="{StaticResource DcCard}">
                <DockPanel LastChildFill="True">
                    <!-- Protocol selector -->
                    <ComboBox DockPanel.Dock="Left" Width="90" Margin="0,0,8,0"
                              ItemsSource="{Binding AvailableProtocols}"
                              SelectedItem="{Binding Protocol}"
                              VerticalAlignment="Center" />

                    <!-- Connect -->
                    <ui:Button DockPanel.Dock="Right"
                               Content="{loc:Loc Browse_Connect}"
                               Command="{Binding ConnectCommand}"
                               Appearance="Primary"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />

                    <!-- Disconnect -->
                    <Button DockPanel.Dock="Right"
                            Content="{loc:Loc Browse_Disconnect}"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />

                    <!-- ProgID (DA/AE only) -->
                    <TextBox DockPanel.Dock="Right" Width="200" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsClassicOpcProtocol, Converter={StaticResource BoolToVis}}"
                                Text="{Binding ServerProgId, UpdateSourceTrigger=PropertyChanged}"
                                controls:Placeholder.Text="ProgID (DA/AE)"
                                ToolTip="{loc:Loc Browse_ProgIdTooltip}" />

                    <!-- 安全连接(仅 UA):无安全 server(如 Prosys None)取消勾选 -->
                    <CheckBox DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                              Content="{loc:Loc TaskEditor_UseSecurity}"
                              IsChecked="{Binding UseSecurity}"
                              Visibility="{Binding IsUaProtocol, Converter={StaticResource BoolToVis}}" />

                    <!-- Server URI -->
                    <TextBox AutomationProperties.AutomationId="BrowseServerUri"
                                Text="{Binding ServerUri, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                controls:Placeholder.Text="opc.tcp://host:port"
                                ToolTip="{loc:Loc Browse_ServerUriTooltip}" />
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══ Row 2: Classic OPC scan bar (DA/AE only) ═══ -->
        <Border Grid.Row="2" Margin="20,0,20,8"
                Visibility="{Binding IsClassicOpcProtocol, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource DcCard}">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="{loc:Loc Browse_ScanByIp}"
                               Style="{StaticResource DcMuted}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="0,0,8,0" />
                    <TextBox Width="160" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Text="{Binding DiscoveryHost, UpdateSourceTrigger=PropertyChanged}"
                                controls:Placeholder.Text="192.168.1.10"
                                ToolTip="{loc:Loc Browse_DiscoveryHostTooltip}" />
                    <Button Content="{loc:Loc Browse_ScanServers}"
                                Command="{Binding ScanServersCommand}"
                                Style="{StaticResource DcBtnGhostSm}"
                                DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="{loc:Loc Browse_DiscoveredLabel}"
                               Style="{StaticResource DcMuted}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding DiscoveredServers}"
                              SelectedItem="{Binding SelectedDiscoveredServer}"
                              VerticalAlignment="Center"
                              ToolTip="{loc:Loc Browse_DiscoveredTooltip}" />
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══ Row 3: Classic OPC advanced — CLSID fallback ═══ -->
        <Expander Grid.Row="3" Margin="20,0,20,8"
                  Header="{loc:Loc Browse_AdvancedClsidHeader}"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Visibility="{Binding IsClassicOpcProtocol, Converter={StaticResource BoolToVis}}"
                  IsExpanded="False">
            <Border Style="{StaticResource DcCard}" Margin="0,4,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="CLSID："
                               Style="{StaticResource DcMuted}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="0,0,8,0" />
                    <TextBox VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{Binding ServerClsid, UpdateSourceTrigger=PropertyChanged}"
                                controls:Placeholder.Text="{}{5CEE2576-...}"
                                ToolTip="{loc:Loc Browse_ClsidTooltip}" />
                </DockPanel>
            </Border>
        </Expander>

        <!-- ═══ Row 4: Breadcrumb + 状态提示 ═══ -->
        <DockPanel Grid.Row="4" Margin="20,0,20,10" LastChildFill="True">
            <Button Content="{loc:Loc Browse_BtnBack}"
                    DockPanel.Dock="Left"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource DcBtnGhostSm}"
                    Margin="0,0,8,0" />
            <Button Content="{loc:Loc Browse_BtnEnter}"
                    DockPanel.Dock="Left"
                    Command="{Binding DrillDownCommand}"
                    Style="{StaticResource DcBtnGhostSm}"
                    Margin="0,0,8,0"
                    ToolTip="{loc:Loc Browse_BtnEnterTooltip}" />
            <Button Content="{loc:Loc Browse_BtnRefreshValues}"
                    DockPanel.Dock="Left"
                    Command="{Binding RefreshValuesCommand}"
                    Style="{StaticResource DcBtnGhostSm}"
                    Margin="0,0,8,0" />
            <TextBlock Text="{Binding CurrentPath}"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <!-- 扫描/连接反馈（StatusMessage：正在扫描…/发现 N 个服务器/未发现/失败） -->
            <TextBlock Text="{Binding StatusMessage}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       FontSize="12" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- ═══ Row 5: Connect error bar ═══ -->
        <Border Grid.Row="5" Margin="20,0,20,8"
                Style="{StaticResource DcAlertBad}"
                Visibility="{Binding IsConnectError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>

        <!-- ═══ Row 6: Split layout — node list + detail panel ═══ -->
        <Grid Grid.Row="6" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Node list card (wrapped in Grid for EmptyState overlay) -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource DcCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding Children}"
                              SelectedItem="{Binding SelectedNode}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- 单元格内容垂直居中：否则文本列默认顶对齐，与居中的复选框/图标错位（字偏上） -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DrillDownCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- 多选列：仅叶子(Variable)可勾，批量「加为 Tag」；对话框单点取用时整列隐藏 -->
                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False"
                                Visibility="{Binding Data.ShowBulkAdd, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding IsItem, Converter={StaticResource BoolToVis}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- 无障碍名本地化(StringFormat 不能放 Binding,故用 MultiBinding+转换器;随语言实时刷) -->
                                            <AutomationProperties.Name>
                                                <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Browse_CheckA11y">
                                                    <Binding Path="Node.DisplayName" />
                                                    <Binding Path="[culture]" Source="{x:Static i18n:LocalizationManager.Instance}" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 图标列：📁 Folder / 🔢 Variable（对齐原型 emoji 首列） -->
                            <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔢" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Node.Kind}" Value="Folder">
                                                            <Setter Property="Text" Value="📁" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Browse_ColName}" Binding="{Binding Node.DisplayName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="NodeId" Binding="{Binding Node.Id}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Browse_ColValue}" Binding="{Binding ValueText}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Browse_ColType}" Binding="{Binding DataTypeText}" Width="76">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- EmptyState overlay: visible when not connected and not loading -->
                <controls:EmptyState
                    Icon="Search24"
                    Title="{loc:Loc Browse_EmptyTitle}"
                    Hint="{loc:Loc Browse_EmptyHint}"
                    ActionText="{loc:Loc Browse_Connect}"
                    ActionCommand="{Binding ConnectCommand}"
                    Visibility="{Binding ShowConnectPrompt, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Right: Detail card -->
            <Border Grid.Column="2" Style="{StaticResource DcCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Browse_DetailHeader}" Style="{StaticResource DcCardHeader}" />

                    <!-- NodeId -->
                    <TextBlock Text="NodeId"
                               Style="{StaticResource DcMuted}" FontSize="11" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding SelectedNode.Node.Id, FallbackValue='—'}"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               FontFamily="Consolas, Cascadia Code, monospace"
                               FontSize="12" TextWrapping="Wrap" />

                    <!-- Display Name -->
                    <TextBlock Text="{loc:Loc Browse_DetailDisplayName}"
                               Style="{StaticResource DcMuted}" FontSize="11" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding SelectedNode.Node.DisplayName, FallbackValue='—'}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />

                    <!-- 节点类 -->
                    <TextBlock Text="{loc:Loc Browse_DetailNodeClass}"
                               Style="{StaticResource DcMuted}" FontSize="11" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding SelectedNodeClass}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />

                    <!-- 数据类型（mock，待接真实节点读取后替换） -->
                    <TextBlock Text="{loc:Loc Browse_DetailDataType}"
                               Style="{StaticResource DcMuted}" FontSize="11" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding SelectedNodeDataType}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />

                    <!-- 当前值（mock，待接真实节点读取后替换） -->
                    <TextBlock Text="{loc:Loc Browse_DetailCurrentValue}"
                               Style="{StaticResource DcMuted}" FontSize="11" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding SelectedNodeValue}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />

                    <!-- Action buttons: 仅保留「复制 NodeId」。新建 Tag 的入口在 Tag 编辑器的「浏览…」按钮,
                         那里会预填 Item 并真正落库;此处再加一个只复制 NodeId 的「加入 Tag」属重复误导。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{loc:Loc Browse_CopyNodeId}"
                                Command="{Binding CopyNodeIdCommand}"
                                Style="{StaticResource DcBtnPrimarySm}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Row 7: 批量「加为 Tag」动作条（勾选节点后出现；对话框单点取用不显示） ═══ -->
        <Border Grid.Row="7" Margin="20,0,20,12"
                Visibility="{Binding ShowActionBar, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource DcCard}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="{loc:Loc Browse_SelectedPrefix}" /><Run Text="{Binding CheckedCount, Mode=OneWay}" /><Run Text="{loc:Loc Browse_NodesSuffix}" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource DcMuted}" Text="{loc:Loc Browse_BulkHint}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailableTasks}"
                                  SelectedItem="{Binding SelectedTaskForAdd}"
                                  DisplayMemberPath="Display"
                                  ToolTip="{loc:Loc Browse_TargetTaskTooltip}" />
                        <Button Content="{loc:Loc Browse_AddAsTag}"
                                Command="{Binding AddToTaskCommand}"
                                Style="{StaticResource DcBtnPrimarySm}" Margin="8,0,0,0" />
                        <Border Width="1" Margin="12,3,12,3"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Button Content="{loc:Loc Browse_NewTask}"
                                Command="{Binding AddToNewTaskCommand}"
                                Style="{StaticResource DcBtnGhostSm}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
