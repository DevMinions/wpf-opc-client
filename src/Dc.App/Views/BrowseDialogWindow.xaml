<Window x:Class="Dc.App.Views.BrowseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dc.App.Views"
        xmlns:loc="clr-namespace:Dc.App.Markup"
        Title="{loc:Loc BrowseDialog_Title}" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1B2636">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#0F1923" BorderBrush="#2A3A50" BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc BrowseDialog_Select}" Width="80" Click="OnOk" IsDefault="True" />
                <Button Content="{loc:Loc Common_Cancel}" Width="80" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
        <views:BrowseView />
    </DockPanel>
</Window>
