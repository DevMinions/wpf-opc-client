<UserControl x:Class="Dc.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dc.App.ViewModels"
             xmlns:dconv="clr-namespace:Dc.App.Views.Dashboard"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.Resources>
            <dconv:BoolInverseConverter x:Key="BoolInverse" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="22,18,22,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DcPageTitle}" />
            <TextBlock Style="{StaticResource DcPageSub}">
                <Run Text="{Binding LogFilePath, Mode=OneWay}" />
                <Run Text="{loc:Loc Logs_LinesSuffix}" />
            </TextBlock>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,0,22,14"
                    VerticalAlignment="Center">
            <!-- Segmented: 自动刷新 / 暂停 -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,8,0"
                    HorizontalAlignment="Left">
                <!-- IsChecked TwoWay 绑 AutoRefresh（暂停=反值），重建不失同步 -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{loc:Loc Logs_AutoRefresh}" Style="{StaticResource DcSegRadio}"
                                 IsChecked="{Binding AutoRefresh, Mode=TwoWay}" />
                    <Rectangle Width="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <RadioButton Content="{loc:Loc Logs_Pause}" Style="{StaticResource DcSegRadio}"
                                 IsChecked="{Binding AutoRefresh, Converter={StaticResource BoolInverse}, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <ComboBox SelectedIndex="{Binding MinLogLevelIndex}"
                      Width="130" VerticalAlignment="Center"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="{loc:Loc Logs_LevelAll}" />
                <ComboBoxItem Content="Information+" />
                <ComboBoxItem Content="Warning+" />
            </ComboBox>
            <Border Width="20" />
            <Button Content="{loc:Loc Logs_OpenFolder}"
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource DcBtnGhostSm}"
                    Margin="0,0,8,0" />
            <Button Content="{loc:Loc Logs_Copy}"
                    Command="{Binding CopyContentCommand}"
                    Style="{StaticResource DcBtnGhostSm}" />
        </StackPanel>

        <!-- 日志卡片：逐行着色 -->
        <Border Grid.Row="2"
                Margin="22,0,22,20"
                Style="{StaticResource DcCard}" Padding="0">
            <ItemsControl ItemsSource="{Binding LogEntriesView}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          FontFamily="Cascadia Mono, Consolas, monospace"
                          FontSize="12">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <!-- CanContentScroll=True 必须设在这个真正的 ScrollViewer 上,否则按像素滚动会
                             realize 全部 ~500 行(VirtualizingStackPanel 虚拟化被废),日志多时卡 UI。
                             设在 ItemsControl 上的同名附加属性不会传到模板内的 ScrollViewer。 -->
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="14,12">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogEntry}">
                        <StackPanel Orientation="Horizontal" Height="20">
                            <!-- Timestamp -->
                            <TextBlock Text="{Binding Timestamp, Mode=OneWay}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,0,6,0" />
                            <!-- Level tag with color -->
                            <TextBlock Text="{Binding LevelTag, Mode=OneWay}"
                                       FontWeight="SemiBold" Margin="0,0,6,0"
                                       Width="32" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Error}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Ok}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Message -->
                            <TextBlock Text="{Binding Message, Mode=OneWay}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
