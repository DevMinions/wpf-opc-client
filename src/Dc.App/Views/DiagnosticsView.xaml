<UserControl x:Class="Dc.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Dc.App.Views.Dashboard"
             xmlns:lconv="clr-namespace:Dc.App.Views.Converters"
             xmlns:i18n="clr-namespace:Dc.App.Services.I18n"
             xmlns:wsv="clr-namespace:Dc.App.Views.Workspace"
             xmlns:controls="clr-namespace:Dc.App.Controls"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <UserControl.Resources>
        <conv:BoolInverseConverter x:Key="BoolInverse" />
        <lconv:LocalizedStateConverter x:Key="LocState" />
        <wsv:SparklineConverter x:Key="Sparkline" />

        <!-- Segmented-control toggle button style (自动刷新 / 暂停) -->
        <Style x:Key="SegButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid cell style: default muted text -->
        <Style x:Key="MutedCell" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Rate/秒 cell: 正常绿，有发送错误转黄 -->
        <Style x:Key="RateCell" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 心跳延迟 cell: >5s 黄(caution)，>2min 失联红(critical)，否则灰 -->
        <Style x:Key="HeartbeatCell" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeartbeatSeverity}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeartbeatSeverity}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 发送错误 cell: critical if >0, else muted -->
        <Style x:Key="ErrorCell" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PublishErrorCount}" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 重启次数 cell: caution if >0, else muted -->
        <Style x:Key="RestartCell" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCell}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RestartCount}" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,18">

                <!-- Page title + sub -->
                <TextBlock Text="{Binding Title}" Style="{StaticResource DcPageTitle}" />
                <TextBlock Text="{loc:Loc Diagnostics_Subtitle}" Style="{StaticResource DcPageSub}" />

                <!-- 汇总指标卡 -->
                <UniformGrid Rows="1" Columns="4" Margin="0,4,0,14">
                    <!-- 活跃任务 -->
                    <Border Style="{StaticResource DcCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Diagnostics_ActiveTasks}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ActiveTaskCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- 总速率/s -->
                    <Border Style="{StaticResource DcCard}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Diagnostics_TotalRate}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalRate, StringFormat={}{0:F1}}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- 发送错误：>0 critical -->
                    <Border Style="{StaticResource DcCard}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Diagnostics_SendErrors}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- 颜色全由下方 Style 决定（值=0 中性、>0 红）：本地 Foreground 会盖过
                                 Style 触发器导致 0 也恒红，故移除；与右侧「重启次数」卡做法一致。 -->
                            <TextBlock Text="{Binding TotalErrors}" FontSize="26" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalErrors}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- 重启：>0 caution -->
                    <Border Style="{StaticResource DcCard}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Diagnostics_RestartCount}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalRestarts}" FontSize="26" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalRestarts}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Toolbar -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <!-- Segmented: 自动刷新 / 暂停 -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="{loc:Loc Diagnostics_AutoRefresh}"
                                          IsChecked="{Binding AutoRefresh}"
                                          Style="{StaticResource SegButton}" />
                            <Rectangle Width="1"
                                       Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ToggleButton Content="{loc:Loc Diagnostics_Pause}"
                                          IsChecked="{Binding AutoRefresh, Converter={StaticResource BoolInverse}}"
                                          Style="{StaticResource SegButton}" />
                        </StackPanel>
                    </Border>

                    <!-- Interval label -->
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{loc:Loc Diagnostics_IntervalPrefix}" /><Run Text="{Binding RefreshIntervalSec, Mode=OneWay}" /><Run Text="s" />
                    </TextBlock>

                    <!-- Spacer -->
                    <Border HorizontalAlignment="Stretch" Margin="8,0" />

                     <!-- 立即刷新 button -->
                     <Button Content="{loc:Loc Diagnostics_RefreshNow}"
                             Command="{Binding RefreshCommand}"
                             Style="{StaticResource DcBtnGhostSm}" />
                </StackPanel>

                <!-- Diagnostics card wrapping DataGrid (Grid for EmptyState overlay) -->
                <Grid>
                <Border Style="{StaticResource DcCard}" Padding="0"
                        Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                    <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="Transparent"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              ColumnHeaderHeight="36"
                              RowHeight="36"
                              SelectionMode="Single"
                              CellStyle="{StaticResource DcDataGridCell}"
                              Margin="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Status dot column:
                                 Default Fill = CriticalBrush (worst case).
                                 When errors==0 → Caution (restarts might be nonzero).
                                 When both errors==0 AND restarts==0 → Success (MultiDataTrigger).
                                 Last-wins rule: MultiDataTrigger listed after single DataTrigger,
                                 so "both zero" overrides "errors zero". -->
                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse x:Name="StatusDot"
                                                 Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <DataTemplate.Triggers>
                                            <!-- errors == 0 → at least caution (may still have restarts) -->
                                            <DataTrigger Binding="{Binding PublishErrorCount}" Value="0">
                                                <Setter TargetName="StatusDot" Property="Fill"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <!-- both == 0 → good (overrides caution above) -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding PublishErrorCount}" Value="0" />
                                                    <Condition Binding="{Binding RestartCount}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="StatusDot" Property="Fill"
                                                        Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 任务列弹性：吸收剩余宽度，其余列固定 → 表格自适应窗宽、右侧列不被截 -->
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColTask}"
                                                Binding="{Binding TaskName}"
                                                Width="*" MinWidth="140" />

                            <!-- 连接状态徽章 pill（对齐 LiveDataView 质量 pill 风格：软底 + 同色 SemiBold 文字）。
                                 默认 Running 绿；DataTrigger 按 ConnectionState 枚举成员名切文案/色。
                                 「✓ 已恢复」绿闪标由 JustRecovered 控制可见（5 刷新帧瞬态，见 DiagnosticsRowViewModel）。 -->
                            <DataGridTemplateColumn Header="{loc:Loc Diagnostics_ColState}" Width="120" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Restarting">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Faulted">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <!-- 状态文案本地化(随语言实时刷):State 枚举名选 Diagnostics_State{Running|Connecting|Restarting|Faulted}。
                                                         颜色仍由下方 DataTrigger 驱动(保留原视觉)。 -->
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocState}" ConverterParameter="Diagnostics_State">
                                                            <Binding Path="State" />
                                                            <Binding Path="[culture]" Source="{x:Static i18n:LocalizationManager.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Restarting">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Faulted">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- 已恢复绿闪标（5 帧瞬态，JustRecovered 控制可见性） -->
                                            <TextBlock Text="{loc:Loc Diagnostics_Recovered}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding JustRecovered, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColStarted}"
                                                Binding="{Binding StartedAt, StringFormat={}{0:HH:mm:ss}}"
                                                Width="80"
                                                CellStyle="{StaticResource MutedCell}" />
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColUptime}"
                                                Binding="{Binding Uptime, StringFormat={}{0:hh\\:mm\\:ss}}"
                                                Width="90"
                                                CellStyle="{StaticResource MutedCell}" />
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColValueCount}"
                                                Binding="{Binding ValueCount}"
                                                Width="100" />
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColRate}"
                                                Binding="{Binding ValuesPerSecond, StringFormat={}{0:F1}}"
                                                Width="80"
                                                CellStyle="{StaticResource RateCell}" />
                            <!-- 速率趋势 sparkline（复用 SparklineConverter；Viewbox 把 200x40 坐标缩放进单元格） -->
                            <DataGridTemplateColumn Header="{loc:Loc Diagnostics_ColTrend}" Width="130" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Viewbox Width="110" Height="22" Stretch="Fill"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Polyline Points="{Binding RateHistory, Converter={StaticResource Sparkline}}"
                                                      Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round" />
                                        </Viewbox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColSendErrors}"
                                                Binding="{Binding PublishErrorCount}"
                                                Width="80"
                                                CellStyle="{StaticResource ErrorCell}" />
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColRestart}"
                                                Binding="{Binding RestartCount}"
                                                Width="70"
                                                CellStyle="{StaticResource RestartCell}" />
                             <DataGridTextColumn Header="{loc:Loc Diagnostics_ColLastHeartbeat}"
                                                 Binding="{Binding LastHeartbeatAt, StringFormat={}{0:HH:mm:ss}}"
                                                 Width="90"
                                                 CellStyle="{StaticResource HeartbeatCell}" />
                            <DataGridTextColumn Header="{loc:Loc Diagnostics_ColTagCount}"
                                                Binding="{Binding SubscribedTagCount}"
                                                Width="70"
                                                CellStyle="{StaticResource MutedCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <controls:EmptyState
                    Icon="Pulse24"
                    Title="{loc:Loc Diagnostics_EmptyTitle}"
                    Hint="{loc:Loc Diagnostics_EmptyHint}"
                    ActionText="{Binding NavigateCtaText}"
                    ActionCommand="{Binding NavigateToWorkspaceCommand}"
                    Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
