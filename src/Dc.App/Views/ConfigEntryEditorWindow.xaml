<views:ModalWindowBase x:Class="Dc.App.Views.ConfigEntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Dc.App.Views"
        xmlns:loc="clr-namespace:Dc.App.Markup"
        Title="{Binding Title}">
    <Grid Background="#80000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Width="460">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Direction="270" />
                </Border.Effect>
                <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource DcBtnGhostSm}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsCancel="True" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="14,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:Loc Common_Cancel}" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource DcBtnGhostSm}" />
                        <Button Content="{loc:Loc Common_Save}" Click="OnSaveClick" IsDefault="True"
                                IsEnabled="{Binding CanSave}" Style="{StaticResource DcBtnPrimarySm}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Margin="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" /><RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Key:"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsReadOnly="{Binding KeyIsReadOnly}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ModalWindowBase>
