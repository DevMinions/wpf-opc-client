<views:ModalWindowBase x:Class="Dc.App.Views.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Dc.App.Views"
        xmlns:controls="clr-namespace:Dc.App.Controls"
        xmlns:loc="clr-namespace:Dc.App.Markup"
        Title="{Binding Title}">
    <Grid Background="#80000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Width="520">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Direction="270" />
                </Border.Effect>
                <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource DcBtnGhostSm}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsCancel="True" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="14,14"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <!-- 实时校验:首条错误内联红字,保存按钮随 CanSave 禁用 -->
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:Loc Common_Cancel}" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource DcBtnGhostSm}" />
                        <Button Content="{loc:Loc Common_Save}" Click="OnSaveClick" IsDefault="True"
                                IsEnabled="{Binding CanSave}" Style="{StaticResource DcBtnPrimarySm}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Margin="20,18">
                <!-- 虚拟开关(所有模式可见) -->
                <CheckBox Content="{loc:Loc TagEditor_IsVirtual}" Margin="0,0,0,12"
                          IsChecked="{Binding IsVirtual}" />

                <!-- 真实面板:缩放字段 -->
                <StackPanel Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisInverse}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_BrowseEllipsis}" Width="64" Margin="6,0,0,0"
                                    Command="{Binding BrowseCommand}" IsEnabled="{Binding CanBrowse}" />
                            <TextBox controls:Placeholder.Text="{loc:Loc TagEditor_ItemPlaceholder}"
                                     AutomationProperties.Name="Item"
                                     Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc TagEditor_ScaleFactorLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" controls:Placeholder.Text="{loc:Loc TagEditor_ScalePlaceholder}"
                                 AutomationProperties.Name="{loc:Loc TagEditor_ScaleFactorName}"
                                 Text="{Binding ScaleFactor, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc TagEditor_OffsetLabel}" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" controls:Placeholder.Text="{loc:Loc TagEditor_ScalePlaceholder}"
                                 AutomationProperties.Name="{loc:Loc TagEditor_OffsetName}"
                                 Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc TagEditor_DataTypeLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Loc TagEditor_DataTypeName}"
                                  ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding DataType}" />
                    </Grid>
                </StackPanel>

                <!-- 虚拟面板:公式字段 + 输入映射 -->
                <StackPanel Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Common_NameLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" controls:Placeholder.Text="{loc:Loc TagEditor_NamePlaceholder}"
                                 AutomationProperties.Name="{loc:Loc TagEditor_FormulaNameName}"
                                 Text="{Binding FormulaName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc TagEditor_ExpressionLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <TextBox Grid.Column="1" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{loc:Loc TagEditor_ExpressionName}"
                                 controls:Placeholder.Text="{loc:Loc TagEditor_ExpressionPlaceholder}"
                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc TagEditor_OutputUnitLabel}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" controls:Placeholder.Text="{loc:Loc TagEditor_OutputUnitPlaceholder}"
                                 AutomationProperties.Name="{loc:Loc TagEditor_OutputUnitName}"
                                 Text="{Binding OutputUnit, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Text="{loc:Loc TagEditor_InputMappingLabel}" Margin="0,4,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding InputBindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Alias}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" Margin="6,0,0,0"
                                              AutomationProperties.Name="{Binding Alias}"
                                              ItemsSource="{Binding DataContext.AvailableInputTags, RelativeSource={RelativeSource AncestorType=views:TagEditorWindow}}"
                                              SelectedItem="{Binding SelectedTag}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Item}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ModalWindowBase>
