<UserControl x:Class="Dc.App.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dc.App.Controls"
             xmlns:loc="clr-namespace:Dc.App.Markup">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar row -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="16,0">

                <!-- Full-toolbar title (standalone page mode) -->
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource DcPageTitle}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}" />

                <!-- Embedded subtitle (workspace tab mode) -->
                <TextBlock Text="{Binding EmbeddedTitle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVis}}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Filter controls (standalone only) -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc Tags_SearchLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0" />
                    <TextBox Width="180"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             controls:Placeholder.Text="{loc:Loc Tags_SearchPlaceholder}"
                             KeyDown="OnSearchKeyDown" />
                     <Button Content="{loc:Loc Common_Query}"
                             Style="{StaticResource DcBtnGhostSm}"
                             Margin="6,0,0,0"
                             Command="{Binding LoadCommand}" />
                </StackPanel>

                <!-- Action buttons:新建/导入/导出。编辑=双击行、删除=选中行按 Del,不再占工具栏。 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Common_New}"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource DcBtnPrimarySm}"
                            Margin="0,0,6,0" />
                    <Button Content="{loc:Loc Common_Import}"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="0,0,6,0" />
                    <Button Content="{loc:Loc Common_Export}"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource DcBtnGhostSm}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Data table (wrapped in Grid for EmptyState overlay) -->
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Tags}"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                      Style="{StaticResource DcDataGrid}"
                      RowStyle="{StaticResource DcDataGridRow}"
                      ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}"
                      RowHeight="36"
                      ColumnHeaderHeight="36">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </DataGrid.InputBindings>
                 <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{loc:Loc Tags_ColDataType}" Binding="{Binding DataTypeText}" Width="80" />
                    <DataGridTextColumn Header="{loc:Loc Tags_ColTask}" Binding="{Binding TaskName}" Width="180" />
                    <DataGridTextColumn Header="{loc:Loc Tags_ColCreatedAt}"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空状态对准「这个任务还没有 Tag」:主 CTA 走发现主路径「浏览节点」,次 CTA 手动新建。 -->
            <controls:EmptyState
                Icon="TagMultiple24"
                Title="{loc:Loc Tags_EmptyTitle}"
                Hint="{loc:Loc Tags_EmptyHint}"
                ActionText="{loc:Loc Tags_EmptyAction}"
                ActionCommand="{Binding BrowseNodesCommand}"
                SecondaryActionText="{loc:Loc Tags_EmptySecondaryAction}"
                SecondaryActionCommand="{Binding NewCommand}"
                Visibility="{Binding Tags.Count, Converter={StaticResource CountToVis}}" />
        </Grid>
    </Grid>
</UserControl>
