<UserControl x:Class="Dc.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dc.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar row -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="16,0">

                <!-- Full-toolbar title (standalone page mode) -->
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource DcPageTitle}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}" />

                <!-- Embedded subtitle (workspace tab mode) -->
                <TextBlock Text="{Binding EmbeddedTitle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVis}}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Filter controls (standalone only) -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="任务筛选:"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Width="220"
                              ItemsSource="{Binding AvailableTasks}"
                              SelectedItem="{Binding TaskFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 任务可读名:Name 为空回落 Server。不显 ULID。 -->
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="清除"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="6,0,0,0"
                            Command="{Binding LoadCommand}"
                            Click="OnClearFilter" />
                </StackPanel>

                <!-- Action buttons (always shown) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- 新建/刷新。编辑=双击行、删除=选中行按 Del,不再占工具栏。 -->
                    <Button Content="新建"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource DcBtnPrimarySm}"
                            Margin="0,0,6,0" />
                    <Button Content="刷新"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource DcBtnGhostSm}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Data table (wrapped in Grid for EmptyState overlay) -->
        <Grid Grid.Row="1">
            <!-- DataGridColumn 不在视觉树,RelativeSource/AncestorType 都取不到 DataContext。
                 用一个 proxy FrameworkElement 桥接:它绑 VM.ShowTaskColumn,列 Visibility 绑 proxy。 -->
            <FrameworkElement x:Name="VmProxy" DataContext="{Binding}" Visibility="Collapsed" />
            <DataGrid ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Style="{StaticResource DcDataGrid}"
                      RowStyle="{StaticResource DcDataGridRow}"
                      ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}"
                      RowHeight="36"
                      ColumnHeaderHeight="36">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="240" />
                    <!-- 所属任务:显任务名(非 ULID)。内嵌模式(工作区已选任务)该列冗余,隐藏。 -->
                    <DataGridTextColumn Header="所属任务" Binding="{Binding TaskName}" Width="220"
                                        Visibility="{Binding DataContext.ShowTaskColumn, Source={x:Reference VmProxy}, Converter={StaticResource BoolToVis}}" />
                    <DataGridTextColumn Header="创建时间"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 无任务空状态:分组必须挂任务下,无任务时引导先建任务,而非弹阻塞框挡死。 -->
            <controls:EmptyState
                Icon="TagMultiple24"
                Title="无任务,无法新建分组"
                Hint="分组必须挂在任务下。请先创建任务,再回来新建分组。"
                ActionText="{Binding CreateTaskCtaText}"
                ActionCommand="{Binding GoCreateTaskCommand}"
                Visibility="{Binding AvailableTasks.Count, Converter={StaticResource CountToVis}}" />
        </Grid>
    </Grid>
</UserControl>
