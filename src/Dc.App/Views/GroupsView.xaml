<UserControl x:Class="Dc.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar row -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="16,0">

                <!-- Full-toolbar title (standalone page mode) -->
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource DcPageTitle}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}" />

                <!-- Embedded subtitle (workspace tab mode) -->
                <TextBlock Text="{Binding EmbeddedTitle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="{Binding IsEmbedded, Converter={StaticResource BoolToVis}}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Filter controls (standalone only) -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowFullToolbar, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="任务筛选:"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Width="220"
                              ItemsSource="{Binding AvailableTasks}"
                              SelectedItem="{Binding TaskFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Server}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding Id}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="清除"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="6,0,0,0"
                            Command="{Binding LoadCommand}"
                            Click="OnClearFilter" />
                </StackPanel>

                <!-- Action buttons (always shown) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="新建"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource DcBtnPrimarySm}"
                            Margin="0,0,6,0" />
                    <Button Content="刷新"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="0,0,6,0" />
                    <Button Content="编辑"
                            Command="{Binding EditCommand}"
                            Style="{StaticResource DcBtnGhostSm}"
                            Margin="0,0,6,0" />
                    <Button Content="删除"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DcBtnGhostSm}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Data table -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                  Style="{StaticResource DcDataGrid}"
                  RowStyle="{StaticResource DcDataGridRow}"
                  ColumnHeaderStyle="{StaticResource DcDataGridColumnHeader}"
                  RowHeight="36"
                  ColumnHeaderHeight="36">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="200" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="所属任务" Binding="{Binding TaskId}" Width="200" />
                <DataGridTextColumn Header="创建时间"
                                    Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
